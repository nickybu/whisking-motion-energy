    "ROI_COLORS = {\n",
    "    \"whisker_roi\": (0, 255, 0),    # green\n",
    "    \"background_roi\": (255, 0, 0), # blue\n",
    "    \"arm_roi\": (0, 0, 255),        # red\n",
    "}\n",
    "\n",
    "def format_time(seconds):\n",
    "    \"\"\"Format seconds as MM:SS.ss\"\"\"\n",
    "    mins = int(seconds) // 60\n",
    "    secs = seconds - mins * 60\n",
    "    return f\"{mins:02d}:{secs:05.2f}\"\n",
    "\n",
    "def load_rois(config_path, video_stem):\n",
    "    \"\"\"Load ROIs for a video from the config file.\"\"\"\n",
    "    with open(config_path) as f:\n",
    "        config = json.load(f)\n",
    "\n",
    "    # Keyed format: lookup by video stem\n",
    "    if video_stem in config:\n",
    "        return config[video_stem]\n",
    "\n",
    "    # Try matching clips back to source\n",
    "    base_stem = re.sub(r'_clip\\d+$', '', video_stem)\n",
    "    base_stem = re.sub(r'_trimmed$', '', base_stem)\n",
    "    if base_stem in config:\n",
    "        return config[base_stem]\n",
    "\n",
    "    # Flat format fallback\n",
    "    if \"whisker_roi\" in config:\n",
    "        return config\n",
    "\n",
    "    available = \", \".join(config.keys()) or \"(none)\"\n",
    "    raise ValueError(f\"No ROIs for '{video_stem}' in {config_path}. Available: {available}\")\n",
    "\n",
    "\n",
    "def draw_rois(frame, rois):\n",
    "    \"\"\"Draw labeled ROI rectangles on the frame.\"\"\"\n",
    "    display = frame.copy()\n",
    "    font = cv2.FONT_HERSHEY_SIMPLEX\n",
    "\n",
    "    for name, roi in rois.items():\n",
    "        color = ROI_COLORS.get(name, (255, 255, 0))\n",
    "        x1, y1 = roi[\"x_min\"], roi[\"y_min\"]\n",
    "        x2, y2 = roi[\"x_max\"], roi[\"y_max\"]\n",
    "        w, h = x2 - x1, y2 - y1\n",
    "\n",
    "        cv2.rectangle(display, (x1, y1), (x2, y2), color, 2)\n",
    "        label = f\"{name.replace('_roi', '')} ({w}x{h})\"\n",
    "        cv2.putText(display, label, (x1, y1 - 8), font, 0.5, color, 1)\n",
    "\n",
    "    return display\n",
    "\n",
    "\n",
    "def render_video(video_path, rois, output_path):\n",
    "    \"\"\"Render full video with ROIs overlaid on every frame.\"\"\"\n",
    "    cap = cv2.VideoCapture(video_path)\n",
    "    if not cap.isOpened():\n",
    "        print(f\"Error: Cannot open {video_path}\")\n",
    "        return\n",
    "\n",
    "    total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))\n",
    "    fps = cap.get(cv2.CAP_PROP_FPS)\n",
    "    width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))\n",
    "    height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))\n",
    "\n",
    "    fourcc = cv2.VideoWriter_fourcc(*'mp4v')\n",
    "    out = cv2.VideoWriter(str(output_path), fourcc, fps, (width, height))\n",
    "\n",
    "    print(f\"Rendering {total_frames} frames to {output_path}...\")\n",
    "\n",
    "    for _ in tqdm(range(total_frames), desc=\"Rendering\"):\n",
    "        ret, frame = cap.read()\n",
    "        if not ret:\n",
    "            break\n",
    "        out.write(draw_rois(frame, rois))\n",
    "\n",
    "    cap.release()\n",
    "    out.release()\n",
    "    print(f\"Saved: {output_path}\")\n",
    "\n",
    "\n",
    "def interactive_preview(video_path, rois, start_frame=None):\n",
    "    \"\"\"Interactive single-frame preview with navigation.\"\"\"\n",
    "    cap = cv2.VideoCapture(video_path)\n",
    "    if not cap.isOpened():\n",
    "        print(f\"Error: Cannot open {video_path}\")\n",
    "        return\n",
    "\n",
    "    total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))\n",
    "    fps = cap.get(cv2.CAP_PROP_FPS)\n",
    "    width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))\n",
    "    height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))\n",
    "\n",
    "    current_frame = start_frame if start_frame is not None else total_frames // 2\n",
    "\n",
    "    cv2.namedWindow(\"Preview ROIs\", cv2.WINDOW_NORMAL)\n",
    "    cv2.resizeWindow(\"Preview ROIs\", min(width, 1280), min(height, 900))\n",
    "\n",
    "    needs_refresh = True\n",
    "\n",
    "    while True:\n",
    "        if needs_refresh:\n",
    "            cap.set(cv2.CAP_PROP_POS_FRAMES, current_frame)\n",
    "            ret, frame = cap.read()\n",
    "            if ret:\n",
    "                display = draw_rois(frame, rois)\n",
    "\n",
    "                time_sec = current_frame / fps\n",
    "                info = f\"Frame {current_frame}/{total_frames}  |  {format_time(time_sec)}  |  a/d w/s b/f  q=quit\"\n",
    "                overlay = display.copy()\n",
    "                cv2.rectangle(overlay, (0, 0), (width, 30), (0, 0, 0), -1)\n",
    "                cv2.addWeighted(overlay, 0.6, display, 0.4, 0, display)\n",
    "                cv2.putText(display, info, (10, 20),\n",
    "                            cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 255, 255), 1)\n",
    "\n",
    "                cv2.imshow(\"Preview ROIs\", display)\n",
    "            needs_refresh = False\n",
    "\n",
    "        key = cv2.waitKeyEx(30)\n",
    "        if key == -1:\n",
    "            continue\n",
    "\n",
    "        jump = 0\n",
    "        if key == ord(\"d\") or key == 63235:\n",
    "            jump = 1\n",
    "        elif key == ord(\"a\") or key == 63234:\n",
    "            jump = -1\n",
    "        elif key == ord(\"s\") or key == 63233:\n",
    "            jump = int(fps)\n",
    "        elif key == ord(\"w\") or key == 63232:\n",
    "            jump = -int(fps)\n",
    "        elif key == ord(\"f\"):\n",
    "            jump = int(fps * 10)\n",
    "        elif key == ord(\"b\"):\n",
    "            jump = -int(fps * 10)\n",
    "        elif key == ord(\"q\") or key == 27:\n",
    "            break\n",
    "\n",
    "        if jump != 0:\n",
    "            current_frame = max(0, min(total_frames - 1, current_frame + jump))\n",
    "            needs_refresh = True\n",
    "\n",
    "    cap.release()\n",
    "    cv2.destroyAllWindows()"
   ]
