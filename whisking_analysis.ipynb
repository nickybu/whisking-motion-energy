    "        needs_refresh = True\n",
    "\n",
    "    elif key == ord(\"o\"):\n",
    "        playing = False\n",
    "        if in_point is None:\n",
    "            print(\"  No IN point set — press 'i' first\")\n",
    "        elif current_frame_num <= in_point:\n",
    "            print(\"  OUT must be after IN point\")\n",
    "        else:\n",
    "            seg = {\"in_frame\": in_point, \"out_frame\": current_frame_num}\n",
    "            exclusions.append(seg)\n",
    "            undo_stack.append(len(exclusions) - 1)\n",
    "            dur = (current_frame_num - in_point) / fps\n",
    "            print(f\"  Exclusion {len(exclusions)}: frames {in_point}-{current_frame_num} ({dur:.2f}s)\")\n",
    "            in_point = None\n",
    "            needs_refresh = True\n",
    "\n",
    "    elif key == ord(\"u\"):\n",
    "        if undo_stack:\n",
    "            idx = undo_stack.pop()\n",
    "            removed = exclusions.pop(idx)\n",
    "            print(f\"  Undid exclusion: frames {removed['in_frame']}-{removed['out_frame']}\")\n",
    "            needs_refresh = True\n",
    "        else:\n",
    "            print(\"  Nothing to undo (no new exclusions this session)\")\n",
    "\n",
    "    elif key == ord(\"x\"):\n",
    "        if in_point is not None:\n",
    "            print(\"  Cancelled in-point\")\n",
    "            in_point = None\n",
    "            needs_refresh = True\n",
    "\n",
    "    elif key == 13:  # ENTER\n",
    "        break\n",
    "\n",
    "    elif key == ord(\"q\"):\n",
    "        skip_cutting = True\n",
    "        break\n",
    "\n",
    "cv2.destroyAllWindows()\n",
    "cap.release()\n",
    "\n",
    "if in_point is not None:\n",
    "    print(f\"\\n  Warning: IN point at frame {in_point} had no matching OUT — discarded\")\n",
    "\n",
    "kept_segments = compute_kept_segments(exclusions, total_frames)\n",
    "\n",
    "if exclusions:\n",
    "    print(f\"\\nExclusions ({len(exclusions)}):\")\n",
    "    for i, seg in enumerate(exclusions, 1):\n",
    "        dur = (seg[\"out_frame\"] - seg[\"in_frame\"]) / fps\n",
    "        print(f\"  {i}: {format_time(seg['in_frame']/fps)} - {format_time(seg['out_frame']/fps)}  ({dur:.1f}s)\")\n",
    "\n",
    "print_segment_summary(kept_segments, fps)\n",
    "\n",
    "if kept_segments and not skip_cutting:\n",
