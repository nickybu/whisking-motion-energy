   "source": [
    "## Interactive Video Clipper\n",
    "\n",
    "Mark segments to EXCLUDE, keep everything else. Extracts kept segments using ffmpeg stream copy.\n",
    "\n",
    "### Controls\n",
    "- a/d     — Back/forward 1 frame\n",
    "- w/s     — Back/forward 1 second\n",
    "- b/f     — Back/forward 10 seconds\n",
    "- SPACE   — Toggle playback (fast-forward)\n",
    "- +/-     — Increase/decrease playback speed (2x–16x)\n",
    "- i       — Mark exclusion IN point\n",
    "- o       — Mark exclusion OUT point\n",
    "- u       — Undo last exclusion\n",
    "- x       — Cancel current in-point\n",
    "- ENTER   — Extract kept clips and quit\n",
    "- q       — Quit without extracting"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "456d7706d8a0c62c",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-04-22T17:12:14.204022Z",
     "start_time": "2026-04-20T17:31:58.006053Z"
    },
    "jupyter": {
     "source_hidden": true
    }
   },
   "outputs": [],
   "source": [
    "# Global state for trackbar callback\n",
    "current_frame_num = 0\n",
    "needs_refresh = True\n",
    "\n",
    "\n",
    "def on_trackbar(val):\n",
    "    global current_frame_num, needs_refresh\n",
    "    current_frame_num = val\n",
    "    needs_refresh = True\n",
    "\n",
    "\n",
    "SIDEBAR_W = 210\n",
    "\n",
    "\n",
    "def format_time(seconds):\n",
    "    \"\"\"Format seconds as MM:SS.ss\"\"\"\n",
    "    mins = int(seconds) // 60\n",
    "    secs = seconds - mins * 60\n",
    "    return f\"{mins:02d}:{secs:05.2f}\"\n",
    "\n",
    "\n",
    "def format_time_ffmpeg(seconds):\n",
    "    \"\"\"Format seconds as HH:MM:SS.mmm for ffmpeg.\"\"\"\n",
    "    h = int(seconds) // 3600\n",
    "    m = (int(seconds) % 3600) // 60\n",
    "    s = seconds - h * 3600 - m * 60\n",
    "    return f\"{h:02d}:{m:02d}:{s:06.3f}\"\n",
    "\n",
    "\n",
    "def read_frame(cap, frame_num):\n",
    "    cap.set(cv2.CAP_PROP_POS_FRAMES, frame_num)\n",
    "    ret, frame = cap.read()\n",
    "    return frame if ret else None\n",
    "\n",
    "\n",
    "def draw_hud(frame, frame_num, fps, total_frames, in_point, exclusions,\n",
    "             playing=False, play_speed=4):\n",
    "    \"\"\"Draw info sidebar on the right side of the frame.\"\"\"\n",
    "    h, w = frame.shape[:2]\n",
    "    canvas = np.zeros((h, w + SIDEBAR_W, 3), dtype=np.uint8)\n",
    "    canvas[:, :w] = frame\n",
    "\n",
    "    sidebar = canvas[:, w:]\n",
    "    font = cv2.FONT_HERSHEY_SIMPLEX\n",
    "    y = 25\n",
    "    line_h = 20\n",
    "\n",
    "    def put(text, color=(255, 255, 255)):\n",
    "        nonlocal y\n",
    "        cv2.putText(sidebar, text, (5, y), font, 0.4, color, 1)\n",
    "        y += line_h\n",
    "\n",
    "    time_sec = frame_num / fps\n",
    "    total_sec = total_frames / fps\n",
    "    put(f\"Frame: {frame_num}/{total_frames}\")\n",
    "    put(f\"Time:  {format_time(time_sec)}/{format_time(total_sec)}\")\n",
    "    put(f\"FPS:   {fps:.1f}\")\n",
    "\n",
    "    if playing:\n",
    "        put(f\"PLAYING {play_speed}x\", (0, 255, 0))\n",
    "    else:\n",
    "        put(\"PAUSED\", (200, 200, 200))\n",
    "\n",
    "    y += 10\n",
    "    if in_point is not None:\n",
    "        put(f\"IN: {in_point} ({format_time(in_point/fps)})\", (0, 200, 255))\n",
    "        dur = (frame_num - in_point) / fps\n",
    "        put(f\"  span: {dur:.2f}s\", (0, 200, 255))\n",
    "    else:\n",
    "        put(\"IN: (none)\", (100, 100, 100))\n",
    "\n",
    "    y += 10\n",
    "    put(f\"Exclusions: {len(exclusions)}\")\n",
    "    for i, seg in enumerate(exclusions):\n",
    "        dur = (seg[\"out_frame\"] - seg[\"in_frame\"]) / fps\n",
    "        color = (100, 100, 255)\n",
    "        put(f\"  {i+1}: {seg['in_frame']}-{seg['out_frame']} ({dur:.1f}s)\", color)\n",
    "        if y > h - 30:\n",
    "            put(f\"  ... +{len(exclusions)-i-1} more\", color)\n",
    "            break\n",
    "\n",
    "    # Draw exclusion zones on the frame (red tint at bottom)\n",
    "    bar_h = 6\n",
    "    bar_y = h - bar_h - 2\n",
    "    for seg in exclusions:\n",
    "        x1 = int(seg[\"in_frame\"] / total_frames * w)\n",
    "        x2 = int(seg[\"out_frame\"] / total_frames * w)\n",
    "        cv2.rectangle(canvas, (x1, bar_y), (x2, bar_y + bar_h), (0, 0, 200), -1)\n",
    "\n",
    "    # Current position marker\n",
    "    cx = int(frame_num / total_frames * w)\n",
    "    cv2.line(canvas, (cx, bar_y - 2), (cx, bar_y + bar_h + 2), (0, 255, 0), 2)\n",
    "\n",
    "    return canvas\n",
    "\n",
    "\n",
    "def compute_kept_segments(exclusions, total_frames):\n",
    "    \"\"\"Invert exclusion list to get kept segments.\"\"\"\n",
    "    if not exclusions:\n",
    "        return [{\"in_frame\": 0, \"out_frame\": total_frames - 1}]\n",
    "\n",
    "    sorted_ex = sorted(exclusions, key=lambda s: s[\"in_frame\"])\n",
    "    kept = []\n",
    "    prev_end = 0\n",
    "\n",
    "    for seg in sorted_ex:\n",
    "        if seg[\"in_frame\"] > prev_end:\n",
    "            kept.append({\"in_frame\": prev_end, \"out_frame\": seg[\"in_frame\"]})\n",
    "        prev_end = max(prev_end, seg[\"out_frame\"])\n",
    "\n",
    "    if prev_end < total_frames:\n",
    "        kept.append({\"in_frame\": prev_end, \"out_frame\": total_frames - 1})\n",
    "\n",
    "    return kept\n",
    "\n",
    "\n",
    "def print_segment_summary(kept_segments, fps):\n",
    "    if not kept_segments:\n",
    "        return\n",
    "    total_kept = sum((s[\"out_frame\"] - s[\"in_frame\"]) / fps for s in kept_segments)\n",
    "    print(f\"\\nKept segments ({len(kept_segments)}):  total {format_time(total_kept)}\")\n",
    "    for i, seg in enumerate(kept_segments, 1):\n",
    "        dur = (seg[\"out_frame\"] - seg[\"in_frame\"]) / fps\n",
    "        print(f\"  {i}: {format_time(seg['in_frame']/fps)} - {format_time(seg['out_frame']/fps)}  ({dur:.1f}s)\")\n",
    "\n",
    "\n",
    "def cut_segments(video_path, segments, fps, output_dir, ffmpeg_path):\n",
    "    \"\"\"Extract kept segments from video using ffmpeg stream copy.\"\"\"\n",
    "    Path(output_dir).mkdir(parents=True, exist_ok=True)\n",
    "    stem = Path(video_path).stem\n",
    "    output_path = Path(output_dir) / f\"{stem}_trimmed.mp4\"\n",
    "\n",
    "    if len(segments) == 1:\n",
    "        seg = segments[0]\n",
    "        start_sec = seg[\"in_frame\"] / fps\n",
    "        duration_sec = (seg[\"out_frame\"] - seg[\"in_frame\"]) / fps\n",
    "\n",
    "        cmd = [\n",
    "            ffmpeg_path, \"-y\",\n",
    "            \"-ss\", format_time_ffmpeg(start_sec),\n",
    "            \"-i\", str(video_path),\n",
    "            \"-t\", format_time_ffmpeg(duration_sec),\n",
    "            \"-c\", \"copy\",\n",
    "            \"-avoid_negative_ts\", \"make_zero\",\n",
    "            str(output_path)\n",
    "        ]\n",
    "        print(f\"  Extracting single segment ({duration_sec:.2f}s)...\")\n",
    "        result = subprocess.run(cmd, capture_output=True, text=True)\n",
    "        if result.returncode != 0:\n",
    "            print(f\"  ffmpeg error: {result.stderr[-300:]}\")\n",
    "            return None\n",
    "        print(f\"  Saved: {output_path}\")\n",
    "        return output_path\n",
    "\n",
    "    # Multiple segments: extract each, then concatenate\n",
    "    with tempfile.TemporaryDirectory() as tmp_dir:\n",
    "        part_paths = []\n",
    "        for i, seg in enumerate(segments):\n",
    "            start_sec = seg[\"in_frame\"] / fps\n",
    "            duration_sec = (seg[\"out_frame\"] - seg[\"in_frame\"]) / fps\n",
    "            part_path = Path(tmp_dir) / f\"part{i+1:03d}.mp4\"\n",
    "\n",
    "            cmd = [\n",
    "                ffmpeg_path, \"-y\",\n",
    "                \"-ss\", format_time_ffmpeg(start_sec),\n",
    "                \"-i\", str(video_path),\n",
    "                \"-t\", format_time_ffmpeg(duration_sec),\n",
    "                \"-c\", \"copy\",\n",
    "                \"-avoid_negative_ts\", \"make_zero\",\n",
    "                str(part_path)\n",
    "            ]\n",
    "            print(f\"  Extracting segment {i+1}/{len(segments)} ({duration_sec:.2f}s)...\")\n",
    "            result = subprocess.run(cmd, capture_output=True, text=True)\n",
    "            if result.returncode != 0:\n",
    "                print(f\"  ffmpeg error on segment {i+1}: {result.stderr[-300:]}\")\n",
    "                continue\n",
    "            part_paths.append(part_path)\n",
    "\n",
    "        if not part_paths:\n",
    "            print(\"  No segments extracted successfully.\")\n",
    "            return None\n",
    "\n",
    "        # Concatenate\n",
    "        concat_file = Path(tmp_dir) / \"concat.txt\"\n",
    "        with open(concat_file, \"w\") as f:\n",
    "            for p in part_paths:\n",
    "                f.write(f\"file '{p}'\\n\")\n",
    "\n",
    "        cmd = [\n",
    "            ffmpeg_path, \"-y\",\n",
    "            \"-f\", \"concat\", \"-safe\", \"0\",\n",
    "            \"-i\", str(concat_file),\n",
    "            \"-c\", \"copy\",\n",
    "            str(output_path)\n",
    "        ]\n",
    "        print(f\"  Concatenating {len(part_paths)} segments...\")\n",
    "        result = subprocess.run(cmd, capture_output=True, text=True)\n",
    "        if result.returncode != 0:\n",
    "            print(f\"  ffmpeg concat error: {result.stderr[-300:]}\")\n",
    "            return None\n",
    "\n",
    "    print(f\"  Saved: {output_path}\")\n",
    "    return output_path\n",
    "\n",
    "\n",
    "def save_metadata(video_path, segments, fps, total_frames, output_dir, exclusions=None):\n",
    "    \"\"\"Save clip metadata to JSON.\"\"\"\n",
    "    stem = Path(video_path).stem\n",
    "    output_path = Path(output_dir) / f\"{stem}_clips.json\"\n",
    "\n",
    "    data = {\n",
    "        \"source_video\": str(video_path),\n",
    "        \"fps\": fps,\n",
    "        \"total_frames\": total_frames,\n",
    "        \"total_duration_sec\": total_frames / fps,\n",
    "        \"timestamp\": datetime.now().isoformat(),\n",
    "    }\n",
    "\n",
    "    if exclusions:\n",
    "        data[\"exclusions\"] = [\n",
    "            {\n",
    "                \"in_frame\": s[\"in_frame\"],\n",
    "                \"out_frame\": s[\"out_frame\"],\n",
    "                \"in_time\": format_time(s[\"in_frame\"] / fps),\n",
    "                \"out_time\": format_time(s[\"out_frame\"] / fps),\n",
    "                \"duration_sec\": (s[\"out_frame\"] - s[\"in_frame\"]) / fps,\n",
    "            }\n",
    "            for s in exclusions\n",
    "        ]\n",
    "\n",
    "    data[\"kept_segments\"] = [\n",
    "        {\n",
    "            \"in_frame\": s[\"in_frame\"],\n",
    "            \"out_frame\": s[\"out_frame\"],\n",
    "            \"in_time\": format_time(s[\"in_frame\"] / fps),\n",
    "            \"out_time\": format_time(s[\"out_frame\"] / fps),\n",
    "            \"duration_sec\": (s[\"out_frame\"] - s[\"in_frame\"]) / fps,\n",
    "        }\n",
    "        for s in segments\n",
    "    ]\n",
    "\n",
    "    with open(output_path, \"w\") as f:\n",
    "        json.dump(data, f, indent=2)\n",
    "    print(f\"  Metadata: {output_path}\")\n",
    "\n",
    "\n",
    "def load_clips_json(video_stem, output_dir):\n",
    "    \"\"\"Load existing clip exclusions for editing.\"\"\"\n",
    "    clips_path = Path(output_dir) / f\"{video_stem}_clips.json\"\n",
    "    if not clips_path.exists():\n",
    "        # Try trimmed variant\n",
    "        base_stem = re.sub(r'_trimmed$', '', video_stem)\n",
    "        clips_path = Path(output_dir) / f\"{base_stem}_clips.json\"\n",
    "        if not clips_path.exists():\n",
    "            raise FileNotFoundError(f\"No clips JSON found for '{video_stem}' in {output_dir}\")\n",
    "\n",
    "    with open(clips_path) as f:\n",
    "        data = json.load(f)\n",
    "\n",
    "    source_path = data.get(\"source_video\")\n",
    "    exclusions = []\n",
    "    for ex in data.get(\"exclusions\", []):\n",
    "        exclusions.append({\"in_frame\": ex[\"in_frame\"], \"out_frame\": ex[\"out_frame\"]})\n",
    "\n",
    "    return source_path, exclusions"
   ]
  },
