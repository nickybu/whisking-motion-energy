   "source": [
    "def detect_bouts(json_path, signal_key, threshold, min_bout_duration=0.05,\n",
    "                 merge_gap=0.05, sigma=2.0):\n",
    "    \"\"\"Detect whisking bouts from ME JSON using a simple threshold.\"\"\"\n",
    "    jp = Path(json_path)\n",
    "    with open(jp) as f:\n",
    "        results = json.load(f)\n",
    "\n",
    "    fps = results['video_info']['fps']\n",
    "    signal = np.array(results['motion_energy'][signal_key])\n",
    "    smoothed = gaussian_filter1d(signal.astype(np.float64), sigma=sigma)\n",
    "\n",
    "    # Binarise\n",
    "    binary = (smoothed > threshold).astype(np.int8)\n",
    "\n",
    "    # Extract bouts from transitions\n",
    "    padded = np.concatenate([[0], binary, [0]])\n",
    "    transitions = np.diff(padded)\n",
    "    onsets = np.where(transitions == 1)[0]\n",
    "    offsets = np.where(transitions == -1)[0]\n",
    "\n",
    "    bouts = []\n",
    "    for on, off in zip(onsets, offsets):\n",
    "        segment = smoothed[on:off]\n",
    "        bouts.append({\n",
    "            'bout_id': len(bouts) + 1,\n",
    "            'onset_frame': int(on),\n",
    "            'offset_frame': int(off),\n",
    "            'duration_frames': int(off - on),\n",
    "            'duration_sec': float((off - on) / fps),\n",
    "            'mean_me': float(segment.mean()),\n",
    "            'peak_me': float(segment.max()),\n",
    "        })\n",
    "\n",
    "    # Merge short gaps\n",
    "    merge_gap_frames = int(merge_gap * fps)\n",
    "    if len(bouts) > 1:\n",
    "        merged = [bouts[0].copy()]\n",
    "        for b in bouts[1:]:\n",
    "            prev = merged[-1]\n",
    "            if b['onset_frame'] - prev['offset_frame'] <= merge_gap_frames:\n",
    "                prev['offset_frame'] = b['offset_frame']\n",
    "                prev['duration_frames'] = prev['offset_frame'] - prev['onset_frame']\n",
    "                prev['duration_sec'] = prev['duration_frames'] / fps\n",
    "                seg = smoothed[prev['onset_frame']:prev['offset_frame']]\n",
    "                prev['mean_me'] = float(seg.mean())\n",
    "                prev['peak_me'] = float(seg.max())\n",
    "            else:\n",
    "                merged.append(b.copy())\n",
    "        bouts = merged\n",
    "\n",
    "    # Remove short bouts\n",
    "    bouts = [b for b in bouts if b['duration_sec'] >= min_bout_duration]\n",
    "    for i, b in enumerate(bouts):\n",
    "        b['bout_id'] = i + 1\n",
    "\n",
    "    # Rebuild binary from final bouts\n",
    "    binary_final = np.zeros(len(signal), dtype=np.int8)\n",
    "    for b in bouts:\n",
    "        binary_final[b['onset_frame']:b['offset_frame']] = 1\n",
    "\n",
    "    # Save CSVs\n",
    "    out_dir = jp.parent\n",
    "    stem = jp.stem.removesuffix('_me')\n",
    "    suffix = f'_{signal_key}'\n",
    "\n",
    "    bout_path = out_dir / f'{stem}_whisking_bouts{suffix}.csv'\n",
    "    with open(bout_path, 'w', newline='') as f:\n",
    "        writer = csv.DictWriter(f, fieldnames=[\n",
    "            'bout_id', 'onset_frame', 'offset_frame',\n",
    "            'duration_frames', 'duration_sec', 'mean_me', 'peak_me'\n",
    "        ])\n",
    "        writer.writeheader()\n",
    "        writer.writerows(bouts)\n",
    "\n",
    "    binary_path = out_dir / f'{stem}_whisking_binary{suffix}.csv'\n",
    "    with open(binary_path, 'w', newline='') as f:\n",
    "        writer = csv.writer(f)\n",
    "        writer.writerow(['frame', 'time_sec', 'whisking'])\n",
    "        for i, val in enumerate(binary_final):\n",
    "            writer.writerow([i, f'{i / fps:.4f}', int(val)])\n",
    "\n",
    "    # Summary\n",
    "    n_whisking = int(binary_final.sum())\n",
    "    pct = n_whisking / len(signal) * 100\n",
    "    print(f\"{stem}:\")\n",
    "    print(f\"  Threshold: {threshold:.2f} | Bouts: {len(bouts)} | Whisking: {pct:.1f}%\")\n",
    "    if bouts:\n",
    "        durations = [b['duration_sec'] for b in bouts]\n",
    "        print(f\"  Duration (s): mean={np.mean(durations):.3f}  median={np.median(durations):.3f}\")\n",
    "    print(f\"  Saved: {bout_path.name}, {binary_path.name}\")"
   ]
  },
