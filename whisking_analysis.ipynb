    "def _apply_heatmap(frame, diff, roi, colormap, alpha, border_color=(0, 255, 0)):\n",
    "    \"\"\"Blend a heatmap of pre-normalized diff values onto a frame within an ROI.\"\"\"\n",
    "    y1, y2 = roi['y_min'], roi['y_max']\n",
    "    x1, x2 = roi['x_min'], roi['x_max']\n",
    "    heatmap = cv2.applyColorMap(diff, colormap)\n",
    "    frame[y1:y2, x1:x2] = cv2.addWeighted(heatmap, alpha, frame[y1:y2, x1:x2], 1 - alpha, 0)\n",
    "    cv2.rectangle(frame, (x1, y1), (x2, y2), border_color, 1)\n",
    "\n",
    "\n",
    "def render_heatmap_videos(video_path, roi_config_path, colormap=cv2.COLORMAP_INFERNO,\n",
    "                          alpha=0.75, percentile_cap=99):\n",
    "    \"\"\"Render heatmap video (squared diff) with whisker + background ROIs.\n",
    "\n",
    "    Generates: <stem>_heatmap.mp4\n",
    "    Colormap: INFERNO (dark/black = low ME, bright yellow = high ME).\n",
    "    \"\"\"\n",
    "    video_path = str(video_path)\n",
    "    video_stem = Path(video_path).stem\n",
    "    rois = load_rois(roi_config_path, video_stem)\n",
    "\n",
    "    whisker = rois['whisker_roi']\n",
    "    bg = rois.get('background_roi')\n",
    "\n",
    "    roi_list = [('whisker', whisker)]\n",
    "    if bg:\n",
    "        roi_list.append(('background', bg))\n",
    "\n",
    "    cap = cv2.VideoCapture(video_path)\n",
    "    if not cap.isOpened():\n",
    "        raise ValueError(f\"Cannot open {video_path}\")\n",
    "\n",
    "    total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))\n",
    "    fps = cap.get(cv2.CAP_PROP_FPS)\n",
    "    width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))\n",
    "    height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))\n",
    "\n",
    "    # Pass 1: determine global ME range\n",
    "    print(f\"Pass 1/2: scanning {total_frames} frames for ME range...\")\n",
    "    prev_gray = None\n",
    "    maxes = []\n",
    "\n",
    "    for _ in tqdm(range(total_frames), desc=\"Scanning\"):\n",
    "        ret, frame = cap.read()\n",
    "        if not ret:\n",
    "            break\n",
    "        gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY).astype(np.float32)\n",
    "        if prev_gray is not None:\n",
    "            diff = gray - prev_gray\n",
    "            frame_max = 0.0\n",
    "            for _, roi in roi_list:\n",
    "                region = diff[roi['y_min']:roi['y_max'], roi['x_min']:roi['x_max']]\n",
    "                frame_max = max(frame_max, (region ** 2).max())\n",
    "            maxes.append(frame_max)\n",
    "        prev_gray = gray\n",
    "\n",
    "    vmax = float(np.percentile(maxes, percentile_cap))\n",
    "    if vmax <= 0:\n",
    "        vmax = 1.0\n",
    "    print(f\"  ME range: 0 \\u2013 {vmax:.1f} (p{percentile_cap})\")\n",
    "\n",
    "    # Pass 2: render video\n",
    "    out_dir = Path(video_path).resolve().parent.parent / 'results' / video_stem\n",
    "    out_dir.mkdir(parents=True, exist_ok=True)\n",
    "    out_path = str(out_dir / f\"{video_stem}_heatmap.mp4\")\n",
    "\n",
    "    cap.set(cv2.CAP_PROP_POS_FRAMES, 0)\n",
    "    fourcc = cv2.VideoWriter_fourcc(*'mp4v')\n",
    "    writer = cv2.VideoWriter(out_path, fourcc, fps, (width, height))\n",
    "\n",
    "    print(f\"Pass 2/2: rendering heatmap video...\")\n",
    "    prev_gray = None\n",
    "\n",
    "    for _ in tqdm(range(total_frames), desc=\"Rendering\"):\n",
    "        ret, frame = cap.read()\n",
    "        if not ret:\n",
    "            break\n",
    "        gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY).astype(np.float32)\n",
    "\n",
    "        if prev_gray is not None:\n",
    "            diff = gray - prev_gray\n",
    "            for _, roi in roi_list:\n",
    "                region = diff[roi['y_min']:roi['y_max'], roi['x_min']:roi['x_max']]\n",
    "                normed = np.clip(region ** 2 / vmax * 255, 0, 255).astype(np.uint8)\n",
    "                _apply_heatmap(frame, normed, roi, colormap, alpha)\n",
    "            writer.write(frame)\n",
    "        else:\n",
    "            writer.write(frame)\n",
    "\n",
    "        prev_gray = gray\n",
    "\n",
    "    cap.release()\n",
    "    writer.release()\n",
    "    print(f\"Saved: {out_path}\")\n",
    "    print(f\"Colormap: INFERNO (dark=low ME, yellow=high ME)\")\n",
    "    print(f\"Scale: fixed. 0\\u2013{vmax:.1f}\")"
   ]
