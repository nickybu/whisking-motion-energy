   "source": [
    "## Motion Energy Computation\n",
    "\n",
    "Compute motion energy (ME) for each ROI as the mean squared pixel difference between consecutive frames:\n",
    "\n",
    "$$ME(t) = \\frac{1}{N_{\\text{px}}} \\sum_{\\text{ROI}} (I(t) - I(t-1))^2$$\n",
    "\n",
    "where $I(t)$ is the grayscale intensity (0–255) at frame $t$ and $N_{\\text{px}}$ is the number of pixels in the ROI.\n",
    "Units: mean Δ²/px (we use the normalised mean instead of sum so that values are comparable across ROIs and videos of different sizes)\n",
    "\n",
    "Produces raw ME timeseries for whisker, background, and arm ROIs.\n",
    "When a background ROI is provided, also computes background-subtracted signal."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "39e55815a8824d9d",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-04-22T17:14:11.760841Z",
     "start_time": "2026-04-22T17:14:11.746292Z"
    }
   },
   "outputs": [],
   "source": [
    "class MotionEnergyAnalyser:\n",
    "    \"\"\"Motion energy analyser using squared frame differences.\n",
    "\n",
    "    ME = sum((I(t) - I(t-1))^2) per ROI.\n",
    "    \"\"\"\n",
    "\n",
    "    def __init__(\n",
    "        self,\n",
    "        video_path: str,\n",
    "        whisker_roi: Dict[str, int],\n",
    "        background_roi: Optional[Dict[str, int]] = None,\n",
    "        arm_roi: Optional[Dict[str, int]] = None,\n",
    "        output_dir: str = 'results',\n",
    "    ):\n",
    "        self.video_path = video_path\n",
    "        self.whisker_roi = whisker_roi\n",
    "        self.background_roi = background_roi\n",
    "        self.arm_roi = arm_roi\n",
    "        self.base_name = Path(video_path).stem\n",
    "        self.output_dir = Path(output_dir) / self.base_name\n",
    "        self.output_dir.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "    @staticmethod\n",
    "    def _roi_me(diff: np.ndarray, roi: Dict[str, int]) -> float:\n",
    "        \"\"\"ME = sum(diff^2) within ROI.\"\"\"\n",
    "        region = diff[roi['y_min']:roi['y_max'],\n",
    "                      roi['x_min']:roi['x_max']]\n",
    "        return float(np.mean(region ** 2))\n",
    "\n",
    "    @staticmethod\n",
    "    def _validate_roi(roi: Dict[str, int], height: int, width: int):\n",
    "        \"\"\"Validate ROI is within frame bounds.\"\"\"\n",
    "        if roi['x_min'] < 0 or roi['x_max'] > width:\n",
    "            raise ValueError(f\"ROI x bounds {roi['x_min']}-{roi['x_max']} outside frame width {width}\")\n",
    "        if roi['y_min'] < 0 or roi['y_max'] > height:\n",
    "            raise ValueError(f\"ROI y bounds {roi['y_min']}-{roi['y_max']} outside frame height {height}\")\n",
    "\n",
    "    def apply_background_subtraction(\n",
    "        self,\n",
    "        whisker_me: np.ndarray,\n",
    "        background_me: np.ndarray,\n",
    "        whisker_n_pixels: int,\n",
    "        background_n_pixels: int\n",
    "    ) -> Tuple[np.ndarray, Dict]:\n",
    "        \"\"\"Apply scaled background subtraction.\n",
    "\n",
    "        bg_sub = whisker_me - (scale_factor * background_me)\n",
    "        where scale_factor = n_whisker_pixels / n_background_pixels\n",
    "        \"\"\"\n",
    "        scale_factor = whisker_n_pixels / background_n_pixels\n",
    "\n",
    "        bg_sub = whisker_me - (scale_factor * background_me)\n",
    "        bg_sub = np.maximum(bg_sub, 0)\n",
    "\n",
    "        correlation = np.corrcoef(whisker_me, background_me)[0, 1]\n",
    "\n",
    "        info = {\n",
    "            'method': 'scaled_subtraction',\n",
    "            'scale_factor': float(scale_factor),\n",
    "            'correlation': float(correlation) if not np.isnan(correlation) else 0.0,\n",
    "            'mean_whisker_raw': float(np.mean(whisker_me)),\n",
    "            'mean_background_raw': float(np.mean(background_me)),\n",
    "            'mean_whisker_bg_sub': float(np.mean(bg_sub))\n",
    "        }\n",
    "\n",
    "        return bg_sub, info\n",
    "\n",
    "    def process_video(self, max_frames: Optional[int] = None) -> Dict:\n",
    "        \"\"\"Process video and compute motion energy.\n",
    "\n",
    "        Returns:\n",
    "            Dictionary with raw ME arrays and optional bg_sub.\n",
    "        \"\"\"\n",
    "        cap = cv2.VideoCapture(self.video_path)\n",
    "\n",
    "        if not cap.isOpened():\n",
    "            raise ValueError(f\"Could not open video: {self.video_path}\")\n",
    "\n",
    "        total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))\n",
    "        fps = cap.get(cv2.CAP_PROP_FPS)\n",
    "        width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))\n",
    "        height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))\n",
    "\n",
    "        if max_frames:\n",
    "            total_frames = min(total_frames, max_frames)\n",
    "\n",
    "        print(f\"Processing video: {self.video_path}\")\n",
    "        print(f\"  Resolution: {width}x{height}\")\n",
    "        print(f\"  FPS: {fps}\")\n",
    "        print(f\"  Frames: {total_frames}\")\n",
    "        print(f\"  Whisker ROI: {self.whisker_roi}\")\n",
    "        if self.background_roi:\n",
    "            print(f\"  Background ROI: {self.background_roi}\")\n",
    "        if self.arm_roi:\n",
    "            print(f\"  Arm ROI: {self.arm_roi}\")\n",
    "\n",
    "        # Validate ROIs\n",
    "        self._validate_roi(self.whisker_roi, height, width)\n",
    "        if self.background_roi:\n",
    "            self._validate_roi(self.background_roi, height, width)\n",
    "        if self.arm_roi:\n",
    "            self._validate_roi(self.arm_roi, height, width)\n",
    "\n",
    "        # Initialize arrays\n",
    "        whisker_raw = np.zeros(total_frames)\n",
    "        background_raw = np.zeros(total_frames) if self.background_roi else None\n",
    "        arm_raw = np.zeros(total_frames) if self.arm_roi else None\n",
    "\n",
    "        # ROI pixel counts (for background subtraction scaling)\n",
    "        whisker_n_pixels = (\n",
    "            (self.whisker_roi['x_max'] - self.whisker_roi['x_min']) *\n",
    "            (self.whisker_roi['y_max'] - self.whisker_roi['y_min'])\n",
    "        )\n",
    "        background_n_pixels = None\n",
    "        if self.background_roi:\n",
    "            background_n_pixels = (\n",
    "                (self.background_roi['x_max'] - self.background_roi['x_min']) *\n",
    "                (self.background_roi['y_max'] - self.background_roi['y_min'])\n",
    "            )\n",
    "\n",
    "        # Process frames\n",
    "        prev_gray = None\n",
    "        for frame_idx in tqdm(range(total_frames), desc=\"Computing motion energy\"):\n",
    "            ret, frame = cap.read()\n",
    "            if not ret:\n",
    "                break\n",
    "\n",
    "            gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY).astype(np.float32)\n",
    "\n",
    "            if prev_gray is not None:\n",
    "                diff = gray - prev_gray\n",
    "\n",
    "                whisker_raw[frame_idx] = self._roi_me(diff, self.whisker_roi)\n",
    "\n",
    "                if self.background_roi:\n",
    "                    background_raw[frame_idx] = self._roi_me(diff, self.background_roi)\n",
    "\n",
    "                if self.arm_roi:\n",
    "                    arm_raw[frame_idx] = self._roi_me(diff, self.arm_roi)\n",
    "\n",
    "            prev_gray = gray\n",
    "\n",
    "        cap.release()\n",
    "\n",
    "        # Background subtraction\n",
    "        whisker_bg_sub = None\n",
    "        subtraction_info = None\n",
    "        if self.background_roi and background_raw is not None:\n",
    "            whisker_bg_sub, subtraction_info = self.apply_background_subtraction(\n",
    "                whisker_raw, background_raw,\n",
    "                whisker_n_pixels, background_n_pixels\n",
    "            )\n",
    "\n",
    "        # Compile results\n",
    "        results = {\n",
    "            'video_info': {\n",
    "                'path': str(self.video_path),\n",
    "                'fps': fps,\n",
    "                'total_frames': total_frames,\n",
    "                'width': width,\n",
    "                'height': height,\n",
    "                'duration_sec': total_frames / fps\n",
    "            },\n",
    "            'roi_config': {\n",
    "                'whisker': self.whisker_roi,\n",
    "                'background': self.background_roi,\n",
    "                'arm': self.arm_roi\n",
    "            },\n",
    "            'motion_energy': {\n",
    "                'whisker_raw': whisker_raw.tolist(),\n",
    "                'whisker_bg_sub': whisker_bg_sub.tolist() if whisker_bg_sub is not None else None,\n",
    "                'background_raw': background_raw.tolist() if background_raw is not None else None,\n",
    "                'arm_raw': arm_raw.tolist() if arm_raw is not None else None,\n",
    "            },\n",
    "            'background_subtraction': subtraction_info,\n",
    "        }\n",
    "\n",
    "        return results\n",
    "\n",
    "    def save_results(self, results: Dict):\n",
    "        \"\"\"Save results to JSON file.\"\"\"\n",
    "        output_path = self.output_dir / f\"{self.base_name}_me.json\"\n",
    "        with open(output_path, 'w') as f:\n",
    "            json.dump(results, f, indent=2)\n",
    "        print(f\"Saved results: {output_path}\")\n",
    "        return output_path\n",
    "\n",
    "    def save_timeseries_csv(self, results: Dict):\n",
    "        \"\"\"Save timeseries data to CSV.\"\"\"\n",
    "        output_path = self.output_dir / f\"{self.base_name}_me_timeseries.csv\"\n",
    "\n",
    "        fps = results['video_info']['fps']\n",
    "        me = results['motion_energy']\n",
    "        n_frames = len(me['whisker_raw'])\n",
    "\n",
    "        with open(output_path, 'w') as f:\n",
    "            header = ['frame', 'time_sec', 'whisker_raw']\n",
    "            if me.get('whisker_bg_sub'):\n",
    "                header.append('whisker_bg_sub')\n",
    "            if me.get('background_raw'):\n",
    "                header.append('background_raw')\n",
    "            if me.get('arm_raw'):\n",
    "                header.append('arm_raw')\n",
    "            f.write(','.join(header) + '\\n')\n",
    "\n",
    "            for i in range(n_frames):\n",
    "                row = [str(i), f\"{i/fps:.4f}\", f\"{me['whisker_raw'][i]:.2f}\"]\n",
    "                if me.get('whisker_bg_sub'):\n",
    "                    row.append(f\"{me['whisker_bg_sub'][i]:.2f}\")\n",
    "                if me.get('background_raw'):\n",
    "                    row.append(f\"{me['background_raw'][i]:.2f}\")\n",
    "                if me.get('arm_raw'):\n",
    "                    row.append(f\"{me['arm_raw'][i]:.2f}\")\n",
    "                f.write(','.join(row) + '\\n')\n",
    "\n",
    "        print(f\"Saved timeseries: {output_path}\")\n",
    "        return output_path\n",
    "\n",
    "\n",
    "def parse_roi_string(roi_str: str) -> Dict[str, int]:\n",
    "    \"\"\"Parse ROI from 'x_min,y_min,x_max,y_max' string.\"\"\"\n",
    "    parts = [int(x.strip()) for x in roi_str.split(',')]\n",
    "    if len(parts) != 4:\n",
    "        raise ValueError(\"ROI must be: x_min,y_min,x_max,y_max\")\n",
    "    return {\n",
    "        'x_min': parts[0],\n",
    "        'y_min': parts[1],\n",
    "        'x_max': parts[2],\n",
    "        'y_max': parts[3]\n",
    "    }\n",
    "\n",
    "\n",
    "def load_roi_config(config_path: str, video_stem: Optional[str] = None) -> Tuple[Dict, Optional[Dict], Optional[Dict]]:\n",
    "    \"\"\"Load ROI config from JSON file.\n",
    "\n",
    "    Supports two formats:\n",
    "    1. Flat: {\"whisker_roi\": {...}, \"background_roi\": {...}, \"arm_roi\": {...}}\n",
    "    2. Multi-video keyed: {\"video_stem\": {\"whisker_roi\": {...}, ...}, ...}\n",
    "\n",
    "    Returns:\n",
    "        Tuple of (whisker_roi, background_roi, arm_roi)\n",
    "    \"\"\"\n",
    "    with open(config_path) as f:\n",
    "        config = json.load(f)\n",
    "\n",
    "    is_keyed = any(\n",
    "        isinstance(v, dict) and ('whisker_roi' in v or 'whisker' in v)\n",
    "        for v in config.values()\n",
    "    )\n",
    "\n",
    "    if is_keyed and video_stem:\n",
    "        if video_stem in config:\n",
    "            config = config[video_stem]\n",
    "        else:\n",
    "            base_stem = re.sub(r'_clip\\d+$', '', video_stem)\n",
    "            base_stem = re.sub(r'_trimmed$', '', base_stem)\n",
    "            if base_stem in config:\n",
    "                config = config[base_stem]\n",
    "            else:\n",
    "                available = \", \".join(config.keys())\n",
    "                raise ValueError(\n",
    "                    f\"No ROI config found for '{video_stem}' (or '{base_stem}'). \"\n",
    "                    f\"Available: {available}\"\n",
    "                )\n",
    "\n",
    "    whisker_roi = config.get('whisker_roi') or config.get('whisker')\n",
    "    background_roi = config.get('background_roi') or config.get('background')\n",
    "    arm_roi = config.get('arm_roi') or config.get('arm')\n",
    "\n",
    "    if not whisker_roi:\n",
    "        raise ValueError(\"Config must contain 'whisker_roi' or 'whisker' key\")\n",
    "\n",
    "    return whisker_roi, background_roi, arm_roi"
   ]
  },
