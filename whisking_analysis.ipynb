   "source": [
    "# ---- Bout detection parameters ----\n",
    "BOUT_THRESHOLD = 100.0       # ME threshold (mean Δ²/px) — set by inspecting the timeseries plot\n",
    "BOUT_MIN_DURATION = 0.1    # seconds — discard bouts shorter than this\n",
    "BOUT_MERGE_GAP = 0.05       # seconds — merge bouts separated by less than this\n",
    "BOUT_SIGMA = 2.0            # Gaussian smoothing sigma (frames)\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 31,
   "id": "bout_detection_func",
   "metadata": {
    "ExecuteTime": {
