    "def _scan_heatmap_vmax(video_path, roi, percentile_cap=99):\n",
    "    \"\"\"Pass 1: scan video to find p99 vmax for heatmap within a single ROI.\"\"\"\n",
    "    cap = cv2.VideoCapture(str(video_path))\n",
    "    total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))\n",
    "    prev_gray = None\n",
    "    maxes = []\n",
    "\n",
    "    print(f\"  Scanning {total_frames} frames for heatmap range...\")\n",
    "    for _ in tqdm(range(total_frames), desc=\"Scanning\"):\n",
    "        ret, frame = cap.read()\n",
    "        if not ret:\n",
    "            break\n",
    "        gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY).astype(np.float32)\n",
    "        if prev_gray is not None:\n",
    "            diff = gray[roi['y_min']:roi['y_max'], roi['x_min']:roi['x_max']] \\\n",
    "                   - prev_gray[roi['y_min']:roi['y_max'], roi['x_min']:roi['x_max']]\n",
    "            maxes.append((diff ** 2).max())\n",
    "        prev_gray = gray\n",
    "\n",
    "    cap.release()\n",
    "    vmax = float(np.percentile(maxes, percentile_cap))\n",
    "    return max(vmax, 1.0)\n",
    "\n",
    "\n",
    "def render_timeseries_video(video_path, json_path, roi_config_path,\n",
    "                             signal_key='whisker_raw',\n",
    "                             colormap=cv2.COLORMAP_INFERNO, alpha=0.75):\n",
    "    \"\"\"Render video with ME heatmap in ROI + timeseries strip.\"\"\"\n",
    "    video_path = str(video_path)\n",
    "    video_stem = Path(video_path).stem\n",
    "\n",
    "    with open(json_path) as f:\n",
    "        results = json.load(f)\n",
    "    fps = results['video_info']['fps']\n",
    "    me = results['motion_energy']\n",
    "    raw_signal = np.array(me[signal_key])\n",
    "    raw_smooth = gaussian_filter1d(raw_signal, sigma=2)\n",
    "    n_frames = len(raw_smooth)\n",
    "    time_axis = np.arange(n_frames) / fps\n",
    "\n",
    "    rois = load_rois(roi_config_path, video_stem)\n",
    "    whisker_roi = rois['whisker_roi']\n",
    "\n",
    "    # Load whisking binary signal if available\n",
    "    out_dir = Path(video_path).resolve().parent.parent / 'results' / video_stem\n",
    "    whisking_binary = None\n",
    "\n",
    "    raw_csv = out_dir / f'{video_stem}_whisking_binary_{signal_key}.csv'\n",
    "    if raw_csv.exists():\n",
    "        with open(raw_csv) as f:\n",
    "            whisking_binary = np.array([int(row['whisking']) for row in csv.DictReader(f)])\n",
    "        print(f\"  Loaded whisking binary ({whisking_binary.sum()} whisking frames)\")\n",
    "    else:\n",
    "        print(f\"  No whisking binary found ({raw_csv.name})\")\n",
    "\n",
    "    vmax = _scan_heatmap_vmax(video_path, whisker_roi)\n",
    "    print(f\"  Heatmap vmax: {vmax:.1f} (p99)\")\n",
    "\n",
    "    cap = cv2.VideoCapture(video_path)\n",
    "    vid_w = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))\n",
    "    vid_h = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))\n",
    "    vid_fps = cap.get(cv2.CAP_PROP_FPS)\n",
    "    total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))\n",
    "\n",
    "    # Pre-render timeseries chart\n",
    "    orig_backend = matplotlib.get_backend()\n",
    "    matplotlib.use('Agg')\n",
    "    strip_h = 150\n",
    "    dpi = 100\n",
    "    fig_w = vid_w / dpi\n",
    "    fig_h = strip_h / dpi\n",
    "    fig, ax_raw = plt.subplots(1, 1, figsize=(fig_w, fig_h), dpi=dpi)\n",
    "\n",
    "    raw_ymax = np.percentile(raw_signal[raw_signal > 0], 99.5) * 1.1 if (raw_signal > 0).any() else 1.0\n",
    "    ax_raw.plot(time_axis, raw_signal, color='orange', linewidth=0.3, linestyle='dotted', alpha=0.5)\n",
    "    ax_raw.plot(time_axis, raw_smooth, color='orange', linewidth=0.8)\n",
    "    ax_raw.set_xlim(0, time_axis[-1])\n",
    "    ax_raw.set_ylim(0, raw_ymax)\n",
    "    ax_raw.set_xlabel('Time (s)', fontsize=8)\n",
    "    ax_raw.set_ylabel(signal_key, fontsize=8)\n",
    "    ax_raw.tick_params(labelsize=7)\n",
    "\n",
    "    fig.tight_layout(pad=0.3)\n",
    "\n",
    "    fig.canvas.draw()\n",
    "    chart_img = np.asarray(fig.canvas.buffer_rgba())[:, :, :3].copy()\n",
    "    actual_strip_h = chart_img.shape[0]\n",
    "    if chart_img.shape[1] != vid_w:\n",
    "        chart_img = cv2.resize(chart_img, (vid_w, actual_strip_h))\n",
    "    strip_h = chart_img.shape[0]\n",
    "\n",
    "    ax_bbox = ax_raw.get_position()\n",
    "    x_left_px = int(ax_bbox.x0 * chart_img.shape[1])\n",
    "    x_right_px = int(ax_bbox.x1 * chart_img.shape[1])\n",
    "    plt.close(fig)\n",
    "    matplotlib.use(orig_backend)\n",
    "\n",
    "    chart_bgr = cv2.cvtColor(chart_img, cv2.COLOR_RGB2BGR)\n",
    "\n",
    "    out_dir.mkdir(parents=True, exist_ok=True)\n",
    "    out_path = str(out_dir / f\"{video_stem}_me_overlay.mp4\")\n",
    "\n",
    "    combined_h = vid_h + strip_h\n",
    "    fourcc = cv2.VideoWriter_fourcc(*'mp4v')\n",
    "    writer = cv2.VideoWriter(out_path, fourcc, vid_fps, (vid_w, combined_h))\n",
    "\n",
    "    print(f\"  Rendering overlay video ({total_frames} frames)...\")\n",
    "    prev_gray = None\n",
    "    for frame_idx in tqdm(range(total_frames), desc=\"Overlay\"):\n",
    "        ret, frame = cap.read()\n",
    "        if not ret:\n",
    "            break\n",
    "\n",
    "        gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY).astype(np.float32)\n",
    "\n",
    "        if prev_gray is not None:\n",
    "            diff = gray[whisker_roi['y_min']:whisker_roi['y_max'],\n",
    "                        whisker_roi['x_min']:whisker_roi['x_max']] \\\n",
    "                   - prev_gray[whisker_roi['y_min']:whisker_roi['y_max'],\n",
    "                               whisker_roi['x_min']:whisker_roi['x_max']]\n",
    "            region_sq = diff ** 2\n",
    "            normed = np.clip(region_sq / vmax * 255, 0, 255).astype(np.uint8)\n",
    "            if whisking_binary is not None and frame_idx < len(whisking_binary):\n",
    "                roi_color = (0, 255, 0) if whisking_binary[frame_idx] else (0, 0, 255)\n",
    "            else:\n",
    "                roi_color = (0, 255, 0)\n",
    "            _apply_heatmap(frame, normed, whisker_roi, colormap, alpha, border_color=roi_color)\n",
    "        else:\n",
    "            roi_color = (0, 0, 255)  # first frame, no diff yet\n",
    "            cv2.rectangle(frame,\n",
    "                          (whisker_roi['x_min'], whisker_roi['y_min']),\n",
    "                          (whisker_roi['x_max'], whisker_roi['y_max']),\n",
    "                          roi_color, 1)\n",
    "        prev_gray = gray\n",
    "\n",
    "        if whisking_binary is not None and frame_idx < len(whisking_binary):\n",
    "            is_w = whisking_binary[frame_idx]\n",
    "            clr = (0, 255, 0) if is_w else (160, 160, 160)\n",
    "            cv2.putText(frame, 'Whisking', (10, 25), cv2.FONT_HERSHEY_SIMPLEX,\n",
    "                        0.6, (0, 0, 0), 3, cv2.LINE_AA)\n",
    "            cv2.putText(frame, 'Whisking', (10, 25), cv2.FONT_HERSHEY_SIMPLEX,\n",
    "                        0.6, clr, 2, cv2.LINE_AA)\n",
    "\n",
    "        strip = chart_bgr.copy()\n",
    "        if frame_idx < n_frames:\n",
    "            frac = frame_idx / max(n_frames - 1, 1)\n",
    "            x_px = int(x_left_px + frac * (x_right_px - x_left_px))\n",
    "            cv2.line(strip, (x_px, 0), (x_px, strip_h), (0, 0, 255), 2)\n",
    "\n",
    "        combined = np.vstack([frame, strip])\n",
    "        writer.write(combined)\n",
    "\n",
    "    cap.release()\n",
    "    writer.release()\n",
    "    print(f\"Saved: {out_path}\")"
   ]
