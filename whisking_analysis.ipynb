    "            'time': time,\n",
    "            'raw': raw,\n",
    "        })\n",
    "\n",
    "    # Truncate to shortest video\n",
    "    min_dur = min(d['time'][-1] for d in datasets)\n",
    "    for d in datasets:\n",
    "        mask = d['time'] <= min_dur\n",
