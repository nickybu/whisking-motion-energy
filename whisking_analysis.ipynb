    "# Open video and grab a frame for ROI selection\n",
    "cap = cv2.VideoCapture(str(VIDEO_PATH))\n",
    "total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))\n",
    "frame_num = total_frames // 2  # change this to pick a different frame\n",
    "cap.set(cv2.CAP_PROP_POS_FRAMES, frame_num)\n",
    "ret, frame = cap.read()\n",
    "cap.release()\n",
    "\n",
    "frame_h, frame_w = frame.shape[:2]\n",
    "print(f\"Video: {VIDEO_PATH.name}\")\n",
    "print(f\"Frame {frame_num}/{total_frames} — {frame_w}x{frame_h}\")\n",
    "\n",
    "# Load existing config for template ROIs (optional)\n",
    "existing = json.loads(ROI_CONFIG_PATH.read_text()) if ROI_CONFIG_PATH.exists() else {}\n",
    "# template = existing.get(\"OTHER_VIDEO_STEM\", {})  # uncomment to copy ROIs from another video\n",
    "\n",
    "cv2.namedWindow(\"Select ROI\", cv2.WINDOW_NORMAL)\n",
    "cv2.resizeWindow(\"Select ROI\", min(frame_w, 1280), min(frame_h, 900))\n",
    "cv2.setMouseCallback(\"Select ROI\", mouse_callback)\n",
    "\n",
    "config = {}\n",
    "for roi_name in [\"whisker_roi\", \"background_roi\"]:\n",
    "    # tmpl = template.get(roi_name)  # uncomment for move mode\n",
    "    result = select_roi(frame, roi_name)\n",
    "    if result == \"QUIT\":\n",
    "        print(\"Quit without saving.\")\n",
    "        break\n",
    "    if result is not None:\n",
    "        config[roi_name] = result\n",
    "        frame = current_frame.copy()\n",
    "\n",
    "cv2.destroyAllWindows()\n",
    "\n",
    "# Save to config\n",
    "existing[VIDEO_STEM] = config\n",
    "ROI_CONFIG_PATH.write_text(json.dumps(existing, indent=2))\n",
    "print(f\"\\nSaved ROIs for '{VIDEO_STEM}' to {ROI_CONFIG_PATH}:\")\n",
    "print(json.dumps(config, indent=2))"
   ]
