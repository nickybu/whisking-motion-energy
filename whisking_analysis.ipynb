    "def plot_timeseries(json_path, signal_key='whisker_raw', output=None):\n",
    "    \"\"\"Plot ME over time: raw + Gaussian smoothed.\"\"\"\n",
    "    with open(json_path) as f:\n",
    "        results = json.load(f)\n",
    "\n",
    "    fps = results['video_info']['fps']\n",
    "    me = results['motion_energy']\n",
    "    signal = np.array(me[signal_key])\n",
    "    smoothed = gaussian_filter1d(signal, sigma=2)\n",
    "    n_frames = len(signal)\n",
    "    time = np.arange(n_frames) / fps\n",
    "\n",
    "    fig, ax = plt.subplots(figsize=(14, 4))\n",
    "    ax.plot(time, signal, alpha=0.4, linewidth=0.3, linestyle='dotted', label='Raw', color='orange')\n",
    "    ax.plot(time, smoothed, linewidth=0.8, label='Gaussian \\u03c3=2', color='orange')\n",
    "    ax.set_xlabel('Time (s)')\n",
    "    ax.set_ylabel('Motion Energy (mean Δ²/px)')\n",
    "    ax.set_title(f'Motion Energy (mean Δ²/px) ({signal_key})')\n",
    "    ax.legend()\n",
    "\n",
    "    plt.tight_layout()\n",
    "\n",
    "    if output is None:\n",
    "        output = Path(json_path).parent / Path(json_path).name.replace('.json', f'_{signal_key}_timeseries.png')\n",
    "    plt.savefig(output, dpi=150, bbox_inches='tight')\n",
    "    print(f\"Saved: {output}\")\n",
    "    plt.close()"
   ]
