    "    ax.set_xlabel('Inter-bout interval (s)')\n",
    "    ax.set_ylabel('Count')\n",
    "    ax.set_title('Inter-Bout Interval Distribution')\n",
    "    ax.legend()\n",
    "    fig.tight_layout()\n",
    "    _save_fig(fig, out_dir / f\"{prefix}_ibi_dist.png\")\n",
    "\n",
    "    # 4. Raster plot\n",
    "    fig, ax = plt.subplots(figsize=(16, 1.5 * len(datasets) + 1))\n",
    "    for i, d in enumerate(datasets):\n",
    "        fps = d['fps']\n",
    "        for b in d['bouts']:\n",
    "            onset_s = b['onset_frame'] / fps\n",
    "            offset_s = b['offset_frame'] / fps\n",
    "            if onset_s > min_dur:\n",
    "                break\n",
    "            offset_s = min(offset_s, min_dur)\n",
    "            ax.barh(i, offset_s - onset_s, left=onset_s, height=0.6,\n",
    "                    color=colors[i], alpha=0.8)\n",
    "    ax.set_yticks(range(len(datasets)))\n",
    "    ax.set_yticklabels([d['label'] for d in datasets])\n",
    "    ax.set_xlabel('Time (s)')\n",
    "    ax.set_xlim(0, min_dur)\n",
    "    ax.set_title('Whisking Bout Raster')\n",
    "    ax.invert_yaxis()\n",
    "    fig.tight_layout()\n",
    "    _save_fig(fig, out_dir / f\"{prefix}_bout_raster.png\")\n",
    "\n",
    "    # 5. Peak ME per bout (log10 histogram)\n",
    "    fig, ax = plt.subplots(figsize=(10, 5))\n",
    "    for i, d in enumerate(datasets):\n",
    "        if d['peak_mes']:\n",
    "            log_peaks = np.log10(d['peak_mes'])\n",
    "            ax.hist(log_peaks, bins=40, alpha=0.15, color=colors[i],\n",
    "                    histtype='stepfilled')\n",
    "            ax.hist(log_peaks, bins=40, color=colors[i],\n",
    "                    histtype='step', linewidth=1.5, label=d['label'])\n",
    "    ax.set_xlabel('log10(Peak ME per bout)')\n",
    "    ax.set_ylabel('Count')\n",
    "    ax.set_title('Peak ME per Bout Distribution')\n",
    "    ax.legend()\n",
    "    fig.tight_layout()\n",
    "    _save_fig(fig, out_dir / f\"{prefix}_bout_peak_me.png\")\n",
    "\n",
    "    # 6. Cumulative whisking %\n",
    "    fig, ax = plt.subplots(figsize=(14, 5))\n",
    "    for i, d in enumerate(datasets):\n",
    "        n = int(min_dur * d['fps'])\n",
    "        binary_trunc = d['binary'][:n]\n",
