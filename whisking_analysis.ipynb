    "from datetime import datetime\n",
    "\n",
    "# --- Interactive clipping ---\n",
    "ffmpeg_path = shutil.which(\"ffmpeg\")\n",
    "if not ffmpeg_path:\n",
    "    raise RuntimeError(\"ffmpeg not found. Install it or set ffmpeg_path manually.\")\n",
    "\n",
    "output_dir = str(PROCESSED_DATA_DIR)\n",
    "\n",
    "cap = cv2.VideoCapture(str(VIDEO_PATH))\n",
    "if not cap.isOpened():\n",
    "    raise RuntimeError(f\"Cannot open {VIDEO_PATH}\")\n",
    "\n",
    "total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))\n",
    "fps = cap.get(cv2.CAP_PROP_FPS)\n",
    "width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))\n",
    "height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))\n",
    "duration_sec = total_frames / fps\n",
    "\n",
    "print(f\"Video: {VIDEO_PATH.name}\")\n",
    "print(f\"  {width}x{height} @ {fps:.0f} fps, {total_frames} frames ({format_time(duration_sec)})\")\n",
    "print(f\"  Output dir: {output_dir}\")\n",
    "print()\n",
    "print(\"Controls:\")\n",
    "print(\"  a/d     Back/forward 1 frame\")\n",
    "print(\"  w/s     Back/forward 1 second\")\n",
    "print(\"  b/f     Back/forward 10 seconds\")\n",
    "print(\"  SPACE   Toggle playback (fast-forward)\")\n",
    "print(\"  +/-     Increase/decrease playback speed\")\n",
    "print(\"  i       Mark exclusion IN point\")\n",
    "print(\"  o       Mark exclusion OUT point\")\n",
    "print(\"  u       Undo last exclusion\")\n",
    "print(\"  x       Cancel in-point\")\n",
    "print(\"  ENTER   Extract kept clips and quit\")\n",
    "print(\"  q       Quit without extracting\")\n",
    "print()\n",
    "print(\"  Mark segments to EXCLUDE — everything else is kept.\")\n",
    "print()\n",
    "\n",
    "current_frame_num = 0\n",
    "needs_refresh = True\n",
    "\n",
    "cv2.namedWindow(\"Clip Video\", cv2.WINDOW_NORMAL | cv2.WINDOW_FREERATIO)\n",
    "cv2.resizeWindow(\"Clip Video\", min(width + SIDEBAR_W, 1490), min(height, 900))\n",
    "cv2.createTrackbar(\"Frame\", \"Clip Video\", current_frame_num, total_frames - 1, on_trackbar)\n",
    "\n",
    "exclusions = []\n",
    "undo_stack = []\n",
    "in_point = None\n",
    "skip_cutting = False\n",
    "playing = False\n",
    "play_speed = 4\n",
    "\n",
    "while True:\n",
    "    if playing:\n",
    "        current_frame_num = min(total_frames - 1, current_frame_num + play_speed)\n",
    "        if current_frame_num >= total_frames - 1:\n",
    "            playing = False\n",
    "        needs_refresh = True\n",
    "\n",
    "    if needs_refresh:\n",
    "        frame = read_frame(cap, current_frame_num)\n",
    "        if frame is not None:\n",
    "            display = draw_hud(frame, current_frame_num, fps, total_frames,\n",
    "                               in_point, exclusions, playing, play_speed)\n",
    "            cv2.imshow(\"Clip Video\", display)\n",
    "            cv2.setTrackbarPos(\"Frame\", \"Clip Video\", current_frame_num)\n",
    "        needs_refresh = False\n",
    "\n",
    "    key = cv2.waitKeyEx(5 if playing else 30)\n",
    "    if key == -1:\n",
    "        continue\n",
    "\n",
    "    jump = 0\n",
    "    if key == ord(\"d\") or key == 63235:\n",
    "        jump = 1\n",
    "    elif key == ord(\"a\") or key == 63234:\n",
    "        jump = -1\n",
    "    elif key == ord(\"s\") or key == 63233:\n",
    "        jump = int(fps)\n",
    "    elif key == ord(\"w\") or key == 63232:\n",
    "        jump = -int(fps)\n",
    "    elif key == ord(\"f\"):\n",
    "        jump = int(fps * 10)\n",
    "    elif key == ord(\"b\"):\n",
    "        jump = -int(fps * 10)\n",
    "\n",
    "    if jump != 0:\n",
    "        playing = False\n",
    "        current_frame_num = max(0, min(total_frames - 1, current_frame_num + jump))\n",
    "        needs_refresh = True\n",
    "        continue\n",
    "\n",
    "    if key == 32:  # SPACE\n",
    "        playing = not playing\n",
    "        if playing:\n",
    "            print(f\"  Playing at {play_speed}x\")\n",
    "        else:\n",
    "            print(f\"  Paused at frame {current_frame_num}\")\n",
    "        needs_refresh = True\n",
    "\n",
    "    elif key == ord(\"+\") or key == ord(\"=\"):\n",
    "        play_speed = min(16, play_speed * 2)\n",
    "        print(f\"  Playback speed: {play_speed}x\")\n",
    "        needs_refresh = True\n",
    "\n",
    "    elif key == ord(\"-\"):\n",
    "        play_speed = max(2, play_speed // 2)\n",
    "        print(f\"  Playback speed: {play_speed}x\")\n",
    "        needs_refresh = True\n",
    "\n",
    "    elif key == ord(\"i\"):\n",
    "        playing = False\n",
    "        in_point = current_frame_num\n",
