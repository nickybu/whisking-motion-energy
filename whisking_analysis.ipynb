    "## Interactive ROI Selection\n",
    "\n",
    "Opens a frame from the video and lets you draw rectangles for each ROI.\n",
    "Saves coordinates to `roi_config.json`, keyed by video filename.\n",
    "\n",
    "### Modes\n",
    "- **Draw** (default): Click and drag to draw each ROI from scratch.\n",
    "- **Move** (`template_roi`): Load ROIs from another video entry and reposition with fixed size.\n",
    "\n",
    "### Controls (both modes)\n",
    "- ENTER/SPACE  — Confirm the current ROI\n",
    "- r            — Redraw / reset to original position\n",
    "- s            — Skip this ROI\n",
    "- q            — Quit without saving\n",
    "\n",
    "### Move mode only\n",
    "- Click        — Reposition ROI centered on click point"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "c4cbf0f1c6024efa",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-04-22T17:13:59.900271Z",
     "start_time": "2026-04-22T17:13:59.891806Z"
    },
    "jupyter": {
     "source_hidden": true
    }
   },
   "outputs": [],
   "source": [
    "# State for mouse callback\n",
    "drawing = False\n",
    "ix, iy = -1, -1\n",
    "rect = None\n",
    "current_frame = None\n",
    "\n",
    "# Move mode state\n",
    "move_mode = False\n",
    "move_width = 0\n",
    "move_height = 0\n",
    "frame_h = 0\n",
    "frame_w = 0\n",
    "\n",
    "\n",
    "def mouse_callback(event, x, y, flags, param):\n",
    "    global drawing, ix, iy, rect, current_frame\n",
    "\n",
    "    if move_mode:\n",
    "        _mouse_callback_move(event, x, y, flags, param)\n",
    "    else:\n",
    "        _mouse_callback_draw(event, x, y, flags, param)\n",
    "\n",
    "\n",
    "def _mouse_callback_draw(event, x, y, flags, param):\n",
    "    global drawing, ix, iy, rect, current_frame\n",
    "\n",
    "    if event == cv2.EVENT_LBUTTONDOWN:\n",
    "        drawing = True\n",
    "        ix, iy = x, y\n",
    "        rect = None\n",
    "\n",
    "    elif event == cv2.EVENT_MOUSEMOVE and drawing:\n",
    "        display = current_frame.copy()\n",
    "        cv2.rectangle(display, (ix, iy), (x, y), (0, 255, 0), 2)\n",
    "        cv2.imshow(\"Select ROI\", display)\n",
    "\n",
    "    elif event == cv2.EVENT_LBUTTONUP:\n",
    "        drawing = False\n",
    "        x_min, x_max = min(ix, x), max(ix, x)\n",
    "        y_min, y_max = min(iy, y), max(iy, y)\n",
    "        if x_max - x_min > 5 and y_max - y_min > 5:\n",
    "            rect = {\"x_min\": x_min, \"y_min\": y_min, \"x_max\": x_max, \"y_max\": y_max}\n",
    "\n",
    "\n",
    "def _mouse_callback_move(event, x, y, flags, param):\n",
    "    \"\"\"In move mode, click to reposition the fixed-size ROI centered on cursor.\"\"\"\n",
    "    global rect, current_frame\n",
    "\n",
    "    if event == cv2.EVENT_LBUTTONDOWN:\n",
    "        half_w = move_width // 2\n",
    "        half_h = move_height // 2\n",
    "        cx = max(half_w, min(frame_w - half_w - (move_width % 2), x))\n",
    "        cy = max(half_h, min(frame_h - half_h - (move_height % 2), y))\n",
    "        x_min = cx - half_w\n",
    "        y_min = cy - half_h\n",
    "\n",
    "        rect = {\n",
    "            \"x_min\": x_min,\n",
    "            \"y_min\": y_min,\n",
    "            \"x_max\": x_min + move_width,\n",
    "            \"y_max\": y_min + move_height,\n",
    "        }\n",
    "\n",
    "        display = current_frame.copy()\n",
    "        cv2.rectangle(display, (rect[\"x_min\"], rect[\"y_min\"]),\n",
    "                       (rect[\"x_max\"], rect[\"y_max\"]), (0, 255, 0), 2)\n",
    "        cv2.imshow(\"Select ROI\", display)\n",
    "\n",
    "\n",
    "def draw_roi_on_frame(frame, roi, label, color=(255, 0, 0)):\n",
    "    \"\"\"Draw a labeled rectangle on the frame.\"\"\"\n",
    "    cv2.rectangle(frame, (roi[\"x_min\"], roi[\"y_min\"]),\n",
    "                  (roi[\"x_max\"], roi[\"y_max\"]), color, 2)\n",
    "    cv2.putText(frame, label, (roi[\"x_min\"], roi[\"y_min\"] - 5),\n",
    "                cv2.FONT_HERSHEY_SIMPLEX, 0.5, color, 1)\n",
    "\n",
    "\n",
    "def select_roi(frame, roi_name, template_roi=None):\n",
    "    \"\"\"Let user draw or move a rectangle for one ROI.\n",
    "\n",
    "    Args:\n",
    "        frame: Base frame to draw on.\n",
    "        roi_name: Name of the ROI (for display).\n",
    "        template_roi: If provided, enter move mode with this ROI's dimensions.\n",
    "\n",
    "    Returns:\n",
    "        ROI dict, None (skipped), or \"QUIT\".\n",
    "    \"\"\"\n",
    "    global current_frame, rect, move_mode, move_width, move_height\n",
    "\n",
    "    rect = None\n",
    "    current_frame = frame.copy()\n",
    "\n",
    "    if template_roi:\n",
    "        move_mode = True\n",
    "        move_width = template_roi[\"x_max\"] - template_roi[\"x_min\"]\n",
    "        move_height = template_roi[\"y_max\"] - template_roi[\"y_min\"]\n",
    "\n",
    "        rect = dict(template_roi)\n",
    "        cv2.rectangle(current_frame,\n",
    "                      (rect[\"x_min\"], rect[\"y_min\"]),\n",
    "                      (rect[\"x_max\"], rect[\"y_max\"]),\n",
    "                      (0, 255, 0), 2)\n",
    "\n",
    "        print(f\"\\n  Move the {roi_name} ROI ({move_width}x{move_height} px).\")\n",
    "        print(f\"  Click to reposition | ENTER/SPACE = confirm | r = reset | s = skip\")\n",
    "    else:\n",
    "        move_mode = False\n",
    "        print(f\"\\n  Draw the {roi_name} ROI on the image.\")\n",
    "        print(f\"  ENTER/SPACE = confirm | r = redraw | s = skip\")\n",
    "\n",
    "    cv2.imshow(\"Select ROI\", current_frame)\n",
    "\n",
    "    while True:\n",
    "        key = cv2.waitKey(50) & 0xFF\n",
    "\n",
    "        if key in (13, 32):  # Enter or Space\n",
    "            if rect is not None:\n",
    "                current_frame = frame.copy()\n",
    "                draw_roi_on_frame(current_frame, rect, roi_name.upper())\n",
    "                cv2.imshow(\"Select ROI\", current_frame)\n",
    "                w = rect[\"x_max\"] - rect[\"x_min\"]\n",
    "                h = rect[\"y_max\"] - rect[\"y_min\"]\n",
    "                print(f\"  {roi_name}: {rect}  ({w}x{h} px)\")\n",
    "                move_mode = False\n",
    "                return rect\n",
    "            else:\n",
    "                print(\"  No rectangle set yet.\")\n",
    "\n",
    "        elif key == ord(\"r\"):\n",
    "            rect = None\n",
    "            current_frame = frame.copy()\n",
    "            if template_roi:\n",
    "                rect = dict(template_roi)\n",
    "                cv2.rectangle(current_frame,\n",
    "                              (rect[\"x_min\"], rect[\"y_min\"]),\n",
    "                              (rect[\"x_max\"], rect[\"y_max\"]),\n",
    "                              (0, 255, 0), 2)\n",
    "                print(\"  Reset to original position.\")\n",
    "            else:\n",
    "                print(\"  Reset — draw again.\")\n",
    "            cv2.imshow(\"Select ROI\", current_frame)\n",
    "\n",
    "        elif key == ord(\"s\"):\n",
    "            print(f\"  Skipped {roi_name}.\")\n",
    "            move_mode = False\n",
    "            return None\n",
    "\n",
    "        elif key == ord(\"q\"):\n",
    "            move_mode = False\n",
    "            return \"QUIT\""
   ]
  },
