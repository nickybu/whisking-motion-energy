    "def _load_bout_data(json_path, signal_suffix=''):\n",
    "    \"\"\"Load bout CSV + binary CSV derived from a ME JSON path.\n",
    "\n",
    "    signal_suffix: e.g. '_whisker_raw' for files from that signal.\n",
    "                   Empty string for default.\n",
    "    \"\"\"\n",
    "    jp = Path(json_path)\n",
    "    stem = jp.stem\n",
    "    label = _get_label(json_path)\n",
    "    bout_csv = jp.parent / f'{stem}_whisking_bouts{signal_suffix}.csv'\n",
    "    binary_csv = jp.parent / f'{stem}_whisking_binary{signal_suffix}.csv'\n",
    "\n",
    "    if not bout_csv.exists():\n",
    "        raise FileNotFoundError(f\"Bout CSV not found: {bout_csv}\\nRun detect_whisking_bouts.py first.\")\n",
    "    if not binary_csv.exists():\n",
    "        raise FileNotFoundError(f\"Binary CSV not found: {binary_csv}\\nRun detect_whisking_bouts.py first.\")\n",
    "\n",
    "    with open(bout_csv) as f:\n",
    "        reader = csv.DictReader(f)\n",
    "        bouts = []\n",
    "        for row in reader:\n",
    "            bouts.append({\n",
    "                'bout_id': int(row['bout_id']),\n",
    "                'onset_frame': int(row['onset_frame']),\n",
    "                'offset_frame': int(row['offset_frame']),\n",
    "                'duration_frames': int(row['duration_frames']),\n",
    "                'duration_sec': float(row['duration_sec']),\n",
    "                'mean_me': float(row['mean_me']),\n",
    "                'peak_me': float(row['peak_me']),\n",
    "            })\n",
    "\n",
    "    with open(binary_csv) as f:\n",
    "        reader = csv.DictReader(f)\n",
    "        binary = np.array([int(row['whisking']) for row in reader])\n",
    "\n",
    "    with open(json_path) as f:\n",
    "        fps = json.load(f)['video_info']['fps']\n",
    "\n",
    "    return label, bouts, binary, fps"
   ]
  },
