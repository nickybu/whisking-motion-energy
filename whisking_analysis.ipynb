    "def compare_bouts(json_paths, signal_suffix=''):\n",
    "    \"\"\"Compare whisking bouts between multiple videos: 6 separate PNGs.\"\"\"\n",
    "    datasets = []\n",
    "    for jp in json_paths:\n",
    "        label, bouts, binary, fps = _load_bout_data(jp, signal_suffix)\n",
    "        datasets.append({\n",
    "            'label': label,\n",
    "            'bouts': bouts,\n",
    "            'binary': binary,\n",
    "            'fps': fps,\n",
    "        })\n",
    "\n",
    "    # Truncate all datasets to shortest video duration\n",
    "    min_frames = min(len(d['binary']) for d in datasets)\n",
    "    min_dur = min_frames / datasets[0]['fps']\n",
    "    print(f\"Truncating to shortest video: {min_frames} frames ({min_dur:.2f}s)\")\n",
    "\n",
    "    for d in datasets:\n",
    "        fps = d['fps']\n",
    "        d['binary'] = d['binary'][:min_frames]\n",
    "        truncated_bouts = []\n",
    "        for b in d['bouts']:\n",
    "            if b['onset_frame'] >= min_frames:\n",
    "                break\n",
    "            if b['offset_frame'] > min_frames:\n",
    "                b = b.copy()\n",
    "                b['offset_frame'] = min_frames\n",
    "                b['duration_frames'] = b['offset_frame'] - b['onset_frame']\n",
    "                b['duration_sec'] = b['duration_frames'] / fps\n",
    "            truncated_bouts.append(b)\n",
    "        d['bouts'] = truncated_bouts\n",
    "        d['durations'] = [b['duration_sec'] for b in d['bouts']]\n",
    "        d['peak_mes'] = [b['peak_me'] for b in d['bouts']]\n",
    "        d['ibis'] = []\n",
    "        for i in range(len(d['bouts']) - 1):\n",
    "            d['ibis'].append((d['bouts'][i + 1]['onset_frame'] - d['bouts'][i]['offset_frame']) / fps)\n",
    "\n",
    "    colors = plt.cm.tab10.colors\n",
    "    labels = [d['label'] for d in datasets]\n",
    "    out_dir = RESULTS_DIR\n",
    "    sig_tag = signal_suffix.lstrip('_') if signal_suffix else 'default'\n",
    "    prefix = f\"bout_comparison_{sig_tag}_{'_vs_'.join(labels)}\"\n",
    "\n",
    "    # 1. Summary table\n",
    "    fig, ax = plt.subplots(figsize=(8, 4))\n",
    "    ax.axis('off')\n",
    "    row_labels = [\n",
    "        'Bout count', 'Whisking %',\n",
    "        'Mean bout duration (s)', 'Median bout duration (s)',\n",
    "        'Mean IBI (s)', 'Median IBI (s)',\n",
    "        'Mean peak ME (mean peak Δ²/px)', 'Median peak ME',\n",
    "    ]\n",
    "    cell_text = []\n",
    "    for r in row_labels:\n",
    "        row = []\n",
    "        for d in datasets:\n",
    "            n_frames = len(d['binary'])\n",
    "            if r == 'Bout count':\n",
    "                row.append(f\"{len(d['bouts'])}\")\n",
    "            elif r == 'Whisking %':\n",
    "                row.append(f\"{d['binary'].sum() / n_frames * 100:.1f}%\")\n",
    "            elif r == 'Mean bout duration (s)':\n",
    "                row.append(f\"{np.mean(d['durations']):.3f}\" if d['durations'] else '\\u2014')\n",
    "            elif r == 'Median bout duration (s)':\n",
    "                row.append(f\"{np.median(d['durations']):.3f}\" if d['durations'] else '\\u2014')\n",
    "            elif r == 'Mean IBI (s)':\n",
    "                row.append(f\"{np.mean(d['ibis']):.3f}\" if d['ibis'] else '\\u2014')\n",
    "            elif r == 'Median IBI (s)':\n",
    "                row.append(f\"{np.median(d['ibis']):.3f}\" if d['ibis'] else '\\u2014')\n",
    "            elif r == 'Mean peak ME (mean peak Δ²/px)':\n",
    "                row.append(f\"{np.mean(d['peak_mes']):.0f}\" if d['peak_mes'] else '\\u2014')\n",
    "            elif r == 'Median peak ME':\n",
    "                row.append(f\"{np.median(d['peak_mes']):.0f}\" if d['peak_mes'] else '\\u2014')\n",
    "        cell_text.append(row)\n",
    "\n",
    "    table = ax.table(cellText=cell_text, rowLabels=row_labels,\n",
    "                     colLabels=[d['label'] for d in datasets],\n",
    "                     cellLoc='center', loc='center')\n",
    "    table.auto_set_font_size(False)\n",
    "    table.set_fontsize(9)\n",
    "    table.scale(1.0, 1.4)\n",
    "    for j, d in enumerate(datasets):\n",
    "        table[0, j].set_facecolor((*colors[j][:3], 0.2))\n",
    "    ax.set_title(f'Whisking Bout Summary (analysis window: {min_dur:.1f}s)', fontsize=12, pad=20)\n",
    "    fig.tight_layout()\n",
    "    _save_fig(fig, out_dir / f\"{prefix}_bout_summary.png\")\n",
    "\n",
    "    # 2. Bout duration distribution\n",
    "    fig, ax = plt.subplots(figsize=(10, 5))\n",
    "    for i, d in enumerate(datasets):\n",
    "        ax.hist(d['durations'], bins=50, alpha=0.15, color=colors[i],\n",
    "                histtype='stepfilled')\n",
    "        ax.hist(d['durations'], bins=50, color=colors[i],\n",
    "                histtype='step', linewidth=1.5, label=d['label'])\n",
    "    ax.set_xlabel('Bout duration (s)')\n",
    "    ax.set_ylabel('Count')\n",
    "    ax.set_title('Bout Duration Distribution')\n",
    "    ax.legend()\n",
    "    fig.tight_layout()\n",
    "    _save_fig(fig, out_dir / f\"{prefix}_bout_duration_dist.png\")\n",
    "\n",
    "    # 3. Inter-bout interval distribution\n",
    "    fig, ax = plt.subplots(figsize=(10, 5))\n",
    "    for i, d in enumerate(datasets):\n",
    "        if d['ibis']:\n",
    "            ax.hist(d['ibis'], bins=50, alpha=0.15, color=colors[i],\n",
